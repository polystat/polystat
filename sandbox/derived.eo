+package sandbox
+alias stdout org.eolang.io.stdout
+alias sprintf org.eolang.txt.sprintf
+alias mutual_rec sandbox.mutual_rec

[] > derived
  mutual_rec > @
  [self v] > f
    self.g > @
      self
      v
